# Пример файла ключей. Скопируй в .env и вставь свои значения.
#   cp .env.example .env
# Либо безопаснее, без ручного редактирования:
#   python3 kitai_cli.py key set GROQ_API_KEY
#
# ВАЖНО: файл .env не попадает в git (он в .gitignore).
# Никогда не публикуй ключи и не присылай их в чат.

# Groq — самый быстрый бесплатный. https://console.groq.com
GROQ_API_KEY=

# Google AI Studio (Gemini). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GitHub Models. Токен с правом models:read.
# https://github.com/marketplace/models
GITHUB_MODELS_TOKEN=

# OpenRouter. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Локальная Ollama. Менять нужно, только если она на другом компьютере.
# Пример для доступа с телефона к домашнему ПК: http://192.168.1.50:11434
OLLAMA_URL=http://localhost:11434
